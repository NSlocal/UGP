<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 📌 JUDUL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Universal Performance"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#1A73E8"
            android:layout_marginBottom="20dp"/>

        <!-- 📊 STATUS UTAMA -->
        <LinearLayout
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Status Sistem"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏹️ Service: STOPPED"
                android:textSize="16sp"
                android:textColor="#E53935"
                android:layout_marginBottom="8dp"/>

            <!-- FPS & SUHU REAL-TIME -->
            <TextView
                android:id="@+id/tv_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮 FPS: 60"
                android:textSize="15sp"
                android:textColor="#2E7D32"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌡️ Suhu: 36.0°C"
                android:textSize="15sp"
                android:textColor="#E65100"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_cpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💻 CPU: Optimal"
                android:textSize="15sp"
                android:textColor="#1565C0"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_gpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 GPU: Accelerated"
                android:textSize="15sp"
                android:textColor="#7B1FA2"/>
        </LinearLayout>

        <!-- 🎛️ KONTROL FITUR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎛️ Kontrol Fitur"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="16dp"/>

            <Switch
                android:id="@+id/sw_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚀 Performance Service"
                android:textSize="15sp"
                android:paddingVertical="10dp"/>

            <Switch
                android:id="@+id/sw_anti_freeze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❄️ Anti Freeze & Frame Stabilizer"
                android:textSize="15sp"
                android:paddingVertical="10dp"/>

            <Switch
                android:id="@+id/sw_cpu_opt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💻 CPU Optimize (Anti Panas)"
                android:textSize="15sp"
                android:paddingVertical="10dp"/>

            <Switch
                android:id="@+id/sw_gpu_opt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎨 GPU Optimize & Acceleration"
                android:textSize="15sp"
                android:paddingVertical="10dp"/>

            <Switch
                android:id="@+id/sw_battery_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔋 Hemat Baterai (Tanpa GMS)"
                android:textSize="15sp"
                android:paddingVertical="10dp"/>
        </LinearLayout>

        <!-- 📌 TOMBOL UTAMA -->
        <Button
            android:id="@+id/btn_toggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶️ START SERVICE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#1A73E8"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Tanpa Google Play Services — Lebih Ringan & Cepat!"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="#666666"
            android:layout_marginTop="16dp"
            android:padding="10dp"
            android:background="#E8F5E9"/>
    </LinearLayout>
</ScrollView>
