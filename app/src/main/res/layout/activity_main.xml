<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Universal Performance"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:textColor="#1A1A1A"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:layout_marginBottom="16dp"
        android:elevation="3dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Controls" android:textSize="22sp" android:textStyle="bold"
            android:layout_marginBottom="20dp" android:textColor="#333333"/>

        <Switch android:id="@+id/switch_service" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Performance Service"
            android:textSize="16sp" android:paddingVertical="8dp"/>

        <Switch android:id="@+id/switch_anti_lag" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Anti Lag Mode"
            android:textSize="16sp" android:paddingVertical="8dp"/>

        <Switch android:id="@+id/switch_gpu_accel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="GPU Acceleration"
            android:textSize="16sp" android:paddingVertical="8dp"/>

        <Switch android:id="@+id/switch_gpu_anti_lag" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="GPU Anti Lag"
            android:textSize="16sp" android:paddingVertical="8dp"/>

        <Switch android:id="@+id/switch_dnd_mode" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="DND & Notif Killer"
            android:textSize="16sp" android:paddingVertical="8dp"/>

        <Switch android:id="@+id/switch_ram_boost" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="RAM Background Anti Lag"
            android:textSize="16sp" android:paddingVertical="8dp"/>

        <Switch android:id="@+id/switch_fps_overlay" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="FPS Real-time Overlay"
            android:textSize="16sp" android:paddingVertical="8dp"/>

        <Switch android:id="@+id/switch_refresh_rate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Refresh Rate Unlock"
            android:textSize="16sp" android:paddingVertical="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:layout_marginBottom="16dp"
        android:elevation="3dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Real-time Monitor" android:textSize="22sp" android:textStyle="bold"
            android:layout_marginBottom="16dp" android:textColor="#333333"/>

        <TextView android:id="@+id/text_fps" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="FPS: 60"
            android:textSize="18sp" android:paddingVertical="8dp"
            android:textColor="#2E7D32" android:textStyle="bold"/>

        <TextView android:id="@+id/text_temp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Suhu: 36.0°C"
            android:textSize="16sp" android:paddingVertical="6dp" android:textColor="#E65100"/>

        <TextView android:id="@+id/text_network" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="WiFi: ON | Data: ON"
            android:textSize="16sp" android:paddingVertical="6dp" android:textColor="#1565C0"/>

        <TextView android:id="@+id/text_refresh_rate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Refresh Rate: 60Hz"
            android:textSize="16sp" android:paddingVertical="6dp" android:textColor="#9C27B0"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="3dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Status" android:textSize="22sp" android:textStyle="bold"
            android:layout_marginBottom="12dp" android:textColor="#333333"/>

        <TextView android:id="@+id/text_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Status: Stopped"
            android:textSize="16sp" android:paddingVertical="4dp" android:textColor="#666666"/>

        <TextView android:id="@+id/text_device_info" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:paddingVertical="4dp" android:textColor="#888888"/>
    </LinearLayout>
</LinearLayout>
